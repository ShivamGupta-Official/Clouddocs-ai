# =============================================================================
# CloudDocs AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to git. It contains secrets.
# =============================================================================

# --- Embedding Model ---
# The Sentence Transformers model used to generate embeddings.
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions, ~90MB, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM Provider ---
# Which LLM provider to use for answer generation.
# Options: "gemini", "openai", "ollama", "none"
# Set to "none" to disable answer generation (retrieval-only mode).
LLM_PROVIDER=none

# --- Google Gemini (if LLM_PROVIDER=gemini) ---
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (if LLM_PROVIDER=openai) ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (if LLM_PROVIDER=ollama) ---
# Ollama runs locally. Install from: https://ollama.ai
# No API key needed. Make sure the Ollama server is running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Application Settings ---
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Text chunking settings
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Relevance score threshold (0.0 to 1.0). Chunks below this are filtered out.
# This is a starting value — evaluate and adjust based on your documents.
# Lower = more permissive, Higher = stricter filtering.
RELEVANCE_THRESHOLD=0.3

# --- Server Settings ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Data Directories ---
# Relative to the project root. Usually no need to change these.
DATA_DIR=data
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chromadb
SQLITE_PATH=data/metadata.db
